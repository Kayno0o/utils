#!/bin/sh
set -e

BUN_PATH=bun

if [ -f ~/.bun/bin/bun ]; then
  BUN_PATH=~/.bun/bin/bun
elif [ -f /usr/local/bin/bun ]; then
  BUN_PATH=/usr/local/bin/bun
fi

# Slow, independent checks run in the background so their latency overlaps build/check/test.
$BUN_PATH run duplicates & DUP_PID=$!
$BUN_PATH x changelogen@latest --dry-run & CHANGELOG_PID=$!

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(json|ts)$' | tr '\n' ' ')
[ -n "$STAGED_FILES" ] && $BUN_PATH eslint --cache $STAGED_FILES

$BUN_PATH run build
$BUN_PATH run check
$BUN_PATH test

wait $DUP_PID
wait $CHANGELOG_PID
