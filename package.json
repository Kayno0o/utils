{
  "name": "@kaynooo/utils",
  "type": "module",
  "version": "1.6.13",
  "description": "A bunch of small utils functions that I use in my TS based projects",
  "author": "Kaynooo <https://git.kaynooo.fr/kaynooo>",
  "license": "MIT",
  "homepage": "https://pages.kaynooo.fr/kaynooo/utils/docs/",
  "repository": {
    "type": "git",
    "url": "https://git.kaynooo.fr/kaynooo/utils"
  },
  "bugs": {
    "url": "https://git.kaynooo.fr/kaynooo/utils/issues"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "keywords": [
    "utils",
    "typescript",
    "ts",
    "javascript",
    "js",
    "esm"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./builders": {
      "types": "./dist/builders/index.d.ts",
      "import": "./dist/builders/index.js"
    },
    "./decorators": {
      "types": "./dist/decorators/index.d.ts",
      "import": "./dist/decorators/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./i18n/date/*": {
      "types": "./dist/i18n/date/*.d.ts",
      "import": "./dist/i18n/date/*.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsgo --noEmit --strict",
    "build": "rm -rf ./dist && tsdown",
    "lint:fix": "bunx --bun eslint --fix",
    "lint": "bunx --bun eslint",
    "doc": "typedoc ./src/**/*.ts --plugin typedoc-github-theme --hostedBaseUrl https://pages.kaynooo.fr/kaynooo/utils/docs/ --useHostedBaseUrlForAbsoluteLinks",
    "test": "rm -rf coverage coverage-report && bun test && genhtml -o coverage -c ./assets/gcov.css ./coverage/lcov.info >/dev/null"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@kaynooo/eslint": "^1.2.0",
    "@types/bun": "^1.2.23",
    "@typescript/native-preview": "^7.0.0-dev.20251015.1",
    "eslint": "^9.36.0",
    "husky": "^9.1.7",
    "tsdown": "^0.16.0",
    "typedoc": "^0.28.13",
    "typedoc-github-theme": "^0.3.1",
    "typescript": "5.9.2"
  }
}
