{
  "name": "@kaynooo/utils",
  "type": "module",
  "version": "3.1.0",
  "description": "A bunch of small utils functions that I use in my TS based projects",
  "author": "Kaynooo <contact@kaynooo.fr> (https://git.kaynooo.fr/kaynooo)",
  "license": "MIT",
  "homepage": "https://pages.kaynooo.fr/kaynooo/utils/docs/",
  "repository": {
    "type": "git",
    "url": "https://git.kaynooo.fr/kaynooo/utils"
  },
  "bugs": {
    "url": "https://git.kaynooo.fr/kaynooo/utils/issues"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "keywords": [
    "utils",
    "typescript",
    "ts",
    "javascript",
    "js",
    "esm"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./builders": {
      "types": "./dist/builders/index.d.ts",
      "import": "./dist/builders/index.js"
    },
    "./decorators": {
      "types": "./dist/decorators/index.d.ts",
      "import": "./dist/decorators/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "bun check --no-script --strict",
    "build": "rm -rf ./dist && bun run scripts/build.ts && tsgo -p tsconfig.build.json",
    "lint:fix": "keslint --fix --cache",
    "circular": "madge --circular --warning ./src/index.ts",
    "lint": "keslint --cache",
    "doc": "typedoc ./src/**/*.ts --plugin typedoc-github-theme --hostedBaseUrl https://pages.kaynooo.fr/kaynooo/utils/docs/ --useHostedBaseUrlForAbsoluteLinks",
    "duplicates": "jscpd ./src --threshold 2 --min-lines 10",
    "test": "rm -rf coverage coverage-report && bun test --parallel && genhtml -o coverage -c ./assets/gcov.css ./coverage/lcov.info >/dev/null"
  },
  "peerDependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "turndown": "^7.2.5",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "@joplin/turndown-plugin-gfm": {
      "optional": true
    },
    "turndown": {
      "optional": true
    }
  },
  "dependencies": {
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@kaynooo/cli-changelog": "2.3.5",
    "@kaynooo/eslint": "8.0.3",
    "@paulmillr/qr": "^0.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.4.4",
    "@types/turndown": "^5.0.6",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "husky": "^9.1.7",
    "jscpd": "5.4.2",
    "madge": "^8.0.0",
    "turndown": "^7.2.5",
    "typedoc": "^0.28.20",
    "typedoc-github-theme": "^0.4.0",
    "typescript": "6.0.3"
  }
}
