{
  "name": "@kaynooo/utils",
  "type": "module",
  "version": "1.9.5",
  "description": "A bunch of small utils functions that I use in my TS based projects",
  "author": "Kaynooo <https://git.kaynooo.fr/kaynooo>",
  "license": "MIT",
  "homepage": "https://pages.kaynooo.fr/kaynooo/utils/docs/",
  "repository": {
    "type": "git",
    "url": "https://git.kaynooo.fr/kaynooo/utils"
  },
  "bugs": {
    "url": "https://git.kaynooo.fr/kaynooo/utils/issues"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "keywords": [
    "utils",
    "typescript",
    "ts",
    "javascript",
    "js",
    "esm"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./browser": {
      "types": "./dist/browser/index.d.mts",
      "import": "./dist/browser/index.mjs"
    },
    "./builders": {
      "types": "./dist/builders/index.d.mts",
      "import": "./dist/builders/index.mjs"
    },
    "./decorators": {
      "types": "./dist/decorators/index.d.mts",
      "import": "./dist/decorators/index.mjs"
    },
    "./format": {
      "types": "./dist/format/index.d.mts",
      "import": "./dist/format/index.mjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.mts",
      "import": "./dist/tools/index.mjs"
    },
    "./*": {
      "types": "./dist/*.d.mts",
      "import": "./dist/*.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsgo --noEmit --strict",
    "build": "rm -rf ./dist && tsdown",
    "lint:fix": "bunx --bun eslint --fix",
    "circular": "madge --circular --warning ./src/index.ts",
    "lint": "bunx --bun eslint",
    "doc": "typedoc ./src/**/*.ts --plugin typedoc-github-theme --hostedBaseUrl https://pages.kaynooo.fr/kaynooo/utils/docs/ --useHostedBaseUrlForAbsoluteLinks",
    "duplicates": "jscpd ./src --threshold 2 --min-lines 10",
    "test": "rm -rf coverage coverage-report && bun test && genhtml -o coverage -c ./assets/gcov.css ./coverage/lcov.info >/dev/null"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@kaynooo/eslint": "^2.1.6",
    "@types/bun": "^1.3.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@typescript/native-preview": "^7.0.0-dev.20260608.1",
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
    "madge": "^8.0.0",
    "tsdown": "^0.22.2",
    "typedoc": "^0.28.19",
    "typedoc-github-theme": "^0.4.0",
    "typescript": "6.0.3"
  }
}
